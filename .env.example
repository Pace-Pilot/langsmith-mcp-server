# LangSmith credentials used by the server for all tool calls (both transports)
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OAuth 2.1 (HTTP transport only). Clerk is the identity provider; clients must use
# CIMD client ids and the authorization code + PKCE flow. Required to start the HTTP app.
CLERK_DOMAIN=verb-noun-12.clerk.accounts.dev
CLERK_OAUTH_CLIENT_ID=your_clerk_oauth_client_id
CLERK_OAUTH_CLIENT_SECRET=your_clerk_oauth_client_secret
MCP_BASE_URL=http://localhost:8000
# MCP_OAUTH_JWT_SIGNING_KEY=            # required only if CLERK_OAUTH_CLIENT_SECRET is omitted
# MCP_OAUTH_REQUIRED_SCOPES=openid email profile
# MCP_OAUTH_ALLOWED_CLIENT_REDIRECT_URIS=
# MCP_OAUTH_REQUIRE_CONSENT=true        # true | false | remember | external
# MCP_OAUTH_REDIRECT_PATH=/auth/callback

# Optional: trace tool calls to a second LangSmith instance
# LANGSMITH_TRACING=true
# LANGSMITH_MONITORING_API_KEY=
# LANGSMITH_MONITORING_ENDPOINT=
# LANGSMITH_MONITORING_WORKSPACE_ID=
# LANGSMITH_MONITORING_PROJECT=mcp-server-monitoring

# Optional (examples/get_usage_trace_counts.py): single workspace (UUID or name) to fetch
# only that workspace in billing usage, or a comma-separated list for the granular section.
# LANGSMITH_WORKSPACE="my-workspace-name"
# LANGSMITH_WORKSPACE_IDS="uuid1,uuid2"
