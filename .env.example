LANGSMITH_API_KEY="your_api_key"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# Optional: single workspace (UUID or name) to fetch only that workspace in billing usage.
# LANGSMITH_WORKSPACE="my-workspace-name"
# LANGSMITH_WORKSPACE_IDS="uuid1,uuid2"  # For granular usage section (comma-separated).

# ----------------------------------------------------------------------------
# HTTP authentication (OAuth 2.1 resource server, Clerk as authorization server)
# Setting CLERK_ISSUER switches the HTTP transport to OAuth mode automatically.
# ----------------------------------------------------------------------------
# MCP_AUTH_MODE="oauth"                      # "oauth" (default when CLERK_ISSUER is set) or "api_key" (legacy header)
# CLERK_ISSUER="https://clerk.example.com"   # Clerk Frontend API URL (prod: clerk.<your-domain>, dev: <slug>.clerk.accounts.dev)
# MCP_SERVER_URL="https://mcp.example.com"   # Public base URL of this server; resource id = MCP_SERVER_URL + /mcp
# MCP_OAUTH_SCOPES_SUPPORTED="openid profile email"   # Advertised in resource metadata and the 401 challenge
# MCP_OAUTH_REQUIRED_SCOPES=""               # Scopes every token must carry (403 insufficient_scope otherwise)
# MCP_OAUTH_AUDIENCE=""                      # Override accepted `aud` values (default: resource URL, with/without trailing slash)
# MCP_OAUTH_JWKS_URL=""                      # Default: CLERK_ISSUER/.well-known/jwks.json
# MCP_OAUTH_RESOURCE_DOCUMENTATION=""        # Optional docs URL published in resource metadata
# MCP_OAUTH_STARTUP_CHECK="true"             # Verify Clerk advertises PKCE S256 + CIMD and has DCR disabled

# Optional Clerk Backend API access (enables opaque-token verification and per-user LangSmith keys
# read from the user's private_metadata.langsmith_api_key / langsmith_workspace_id / langsmith_endpoint)
# CLERK_SECRET_KEY="sk_live_..."
# CLERK_API_URL="https://api.clerk.com"
# MCP_OAUTH_ALLOW_OPAQUE_TOKENS="true"
# MCP_OAUTH_USER_CREDENTIALS_FROM_CLERK="true"
